# ════════════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ════════════════════════════════════════════════════════════════════
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
API_URL=http://localhost:4000
FRONTEND_DATING_URL=http://localhost:3000
FRONTEND_ADULT_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ════════════════════════════════════════════════════════════════════
# ZEGOCLOUD
# ════════════════════════════════════════════════════════════════════
ZEGO_APP_ID=your_zego_app_id_here                    # numeric, from ZegoCloud console
ZEGO_SERVER_SECRET=your_zego_server_secret_here      # 32-char string from console
NEXT_PUBLIC_ZEGO_APP_ID=your_zego_app_id_here        # same value, exposed to frontend
# Note: ZEGO_SERVER_SECRET must NEVER be in NEXT_PUBLIC_ — backend only

# ════════════════════════════════════════════════════════════════════
# MONGODB
# ════════════════════════════════════════════════════════════════════
MONGODB_URI=mongodb://localhost:27017/vibe
MONGODB_DATING_URI=mongodb+srv://user:pass@cluster.mongodb.net/dating_db
MONGODB_ADULT_URI=mongodb+srv://user:pass@cluster.mongodb.net/adult_db
MONGODB_DATING_URI_TEST=mongodb://localhost:27017/dating_test
MONGODB_ADULT_URI_TEST=mongodb://localhost:27017/adult_test

# ════════════════════════════════════════════════════════════════════
# REDIS
# ════════════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=                                      # leave blank for local dev

# ════════════════════════════════════════════════════════════════════
# JWT — SEPARATE SECRETS PER ZONE
# ════════════════════════════════════════════════════════════════════
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_DATING_SECRET=minimum_64_char_random_string_for_dating_zone_replace_this
JWT_ADULT_SECRET=minimum_64_char_different_random_string_for_adult_zone_replace
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ════════════════════════════════════════════════════════════════════
# GOOGLE OAUTH
# ════════════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ════════════════════════════════════════════════════════════════════
# EMAIL — BREVO
# ════════════════════════════════════════════════════════════════════
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=noreply@zippo.com.ng
BREVO_FROM_NAME=Zippo
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_RESET_URL=http://localhost:3000/reset-password

# ════════════════════════════════════════════════════════════════════
# SMS — TWILIO
# ════════════════════════════════════════════════════════════════════
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ════════════════════════════════════════════════════════════════════
# AWS S3 — FILE STORAGE
# ════════════════════════════════════════════════════════════════════
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
S3_BUCKET_PUBLIC=yourapp-public-media
S3_BUCKET_ADULT=yourapp-adult-media
S3_BUCKET_PRIVATE=yourapp-private-documents
S3_PRESIGNED_URL_EXPIRES=900                         # 15 minutes in seconds

# ════════════════════════════════════════════════════════════════════
# STRIPE — PAYMENTS
# ════════════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Credit bundle Stripe price IDs
STRIPE_PRICE_BUNDLE_100=price_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BUNDLE_500=price_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BUNDLE_1500=price_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BUNDLE_5000=price_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Subscription Stripe price IDs
STRIPE_PRICE_GOLD_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_GOLD_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PLATINUM_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PLATINUM_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_DIAMOND_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_DIAMOND_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ════════════════════════════════════════════════════════════════════
# LOCATION — NOMINATIM GEOCODING
# ════════════════════════════════════════════════════════════════════
NOMINATIM_USER_AGENT=YourAppName/1.0 (yourcontact@email.com)
# Required by Nominatim usage policy

# ════════════════════════════════════════════════════════════════════
# RATE LIMITING
# ════════════════════════════════════════════════════════════════════
RATE_LIMIT_WINDOW_MS=900000                          # 15 minutes
RATE_LIMIT_AUTH_MAX=5                                # max auth attempts per window
RATE_LIMIT_API_MAX=100                               # max API calls per window
RATE_LIMIT_TIP_MAX=20                                # max tips per hour per user
RATE_LIMIT_MAX_REQUESTS=100

# ════════════════════════════════════════════════════════════════════
# MONITORING — SENTRY
# ════════════════════════════════════════════════════════════════════
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXX.ingest.sentry.io/XXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # for source map uploads

# ════════════════════════════════════════════════════════════════════
# APP URLS — FRONTEND
# ════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADULT_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_ENABLE_RANDOM_MATCHING=true
NEXT_PUBLIC_ENABLE_LIVE_CAM=true
NEXT_PUBLIC_ENABLE_CRYPTO_PAYMENTS=false             # toggle crypto payout on/off

# ════════════════════════════════════════════════════════════════════
# CRON / BACKGROUND JOBS
# ════════════════════════════════════════════════════════════════════
SERVICE_AUTO_COMPLETE_HOURS=72                       # hours before auto-completing service
CRON_TIMEZONE=UTC
NOTIFICATION_CRON_SCHEDULE=0 0 * * *

# ════════════════════════════════════════════════════════════════════
# FIREBASE CONFIGURATION
# ════════════════════════════════════════════════════════════════════
FIREBASE_VAPID_KEY=your_firebase_vapid_key_here
FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "...", ...}'
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_auth_domain
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# ════════════════════════════════════════════════════════════════════
# LEGACY — NO LONGER USED (kept for reference)
# ════════════════════════════════════════════════════════════════════
# MUX_TOKEN_ID=xxxx          # replaced by ZegoCloud
# MUX_TOKEN_SECRET=xxxx      # replaced by ZegoCloud
# TURN_SERVER_URL=xxxx       # replaced by ZegoCloud (manages TURN internally)
# TURN_USERNAME=xxxx         # replaced by ZegoCloud
# TURN_CREDENTIAL=xxxx       # replaced by ZegoCloud
